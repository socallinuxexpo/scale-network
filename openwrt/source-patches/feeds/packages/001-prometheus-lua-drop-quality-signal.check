TARGET=feed:packages
LUAC_FILES=utils/prometheus-node-exporter-lua/files/usr/lib/lua/prometheus-collectors/wifi.lua
UPSTREAM_NOTES=not submitted upstream. Advisory; drop when the runtime test PASSes without this patch.
RUNTIME_TEST=tests/serverspec/spec/files/wifi_lua_metrics_test.sh
