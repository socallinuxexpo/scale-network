diff --git a/package/network/services/uhttpd/patches/100-ucode-add-fallback-to-avoid-compilation-error.patch b/package/network/services/uhttpd/patches/100-ucode-add-fallback-to-avoid-compilation-error.patch
new file mode 100644
index 0000000..5b06125
--- /dev/null
+++ b/package/network/services/uhttpd/patches/100-ucode-add-fallback-to-avoid-compilation-error.patch
@@ -0,0 +1,37 @@
+From ca796d7dec5697a2d1a7a42be79677f239b64282 Mon Sep 17 00:00:00 2001
+From: Felix Fietkau <nbd@nbd.name>
+Date: Mon, 19 Oct 2026 18:54:31 +0200
+Subject: [PATCH] ucode: add fallback to avoid compilation error
+
+Do not fail on missing STATUS_BREAK check
+
+Signed-off-by: Felix Fietkau <nbd@nbd.name>
+---
+ ucode.c | 7 ++++---
+ 1 file changed, 4 insertions(+), 3 deletions(-)
+
+diff --git a/ucode.c b/ucode.c
+index bbb9b00..0bd321b 100644
+--- a/ucode.c
++++ b/ucode.c
+@@ -285,9 +285,6 @@ uh_ucode_state_init(struct ucode_prefix *ucode)
+ 	ucv_put(v);
+ 
+ 	switch (status) {
+-	case STATUS_OK:
+-		break;
+-
+ 	case STATUS_EXIT:
+ 		fprintf(stderr, "Error: The ucode handler invoked exit(%d)\n", exitcode);
+ 		exit(exitcode ? exitcode : 1);
+@@ -299,6 +296,10 @@ uh_ucode_state_init(struct ucode_prefix *ucode)
+ 	case ERROR_RUNTIME:
+ 		fprintf(stderr, "Error: Runtime error while executing ucode handler\n");
+ 		exit(2);
++
++	case STATUS_OK:
++	default:
++		break;
+ 	}
+ 
+ 	v = ucv_object_get(uc_vm_scope_get(vm), UH_UCODE_CB, NULL);
diff --git a/package/system/rpcd/patches/100-ucode-add-compatibility-to-newer-ucode-version.patch b/package/system/rpcd/patches/100-ucode-add-compatibility-to-newer-ucode-version.patch
new file mode 100644
index 0000000..f6e5849
--- /dev/null
+++ b/package/system/rpcd/patches/100-ucode-add-compatibility-to-newer-ucode-version.patch
@@ -0,0 +1,27 @@
+From a6c6b63 Mon Sep 17 00:00:00 2001
+From: Felix Fietkau <nbd@nbd.name>
+Date: Fri, 25 Sep 2026 13:12:42 +0200
+Subject: [PATCH] ucode: add compatibility to newer ucode version
+
+It adds STATUS_BREAK for breakpoints. Add a default switch/case fallback
+to avoid running into the unhandled case warning/error.
+
+Signed-off-by: Felix Fietkau <nbd@nbd.name>
+---
+ ucode.c | 3 +++
+ 1 file changed, 3 insertions(+)
+
+diff --git a/ucode.c b/ucode.c
+index 86a732d..891253a 100644
+--- a/ucode.c
++++ b/ucode.c
+@@ -985,6 +985,9 @@ rpc_ucode_script_execute(struct ubus_context *ctx, const char *path, uc_program_
